! -------------------------------------------------------------------- !
! WAVEWATCH III - ww3_ounf.nml - Grid output post-processing           !
! Level0 NetCDF files
! -------------------------------------------------------------------- !

! -------------------------------------------------------------------- !
! Define the output fields to postprocess via FIELD_NML namelist
! -------------------------------------------------------------------- !
&FIELD_NML
  FIELD%TIMESTART        =  '<start_year><start_month>01 000000'
  FIELD%TIMESTRIDE       =  '<stepping>'
  FIELD%TIMECOUNT        =  '<num_outs>'
  FIELD%TIMEREF          =  '<start_year><start_month>01 000000'
  FIELD%TIMESPLIT        =  0
  FIELD%LIST             =  'HS T02 T0M1 T01 TP DIR SPR DP PHS PTP PDIR PSPR TWS MSS USS'
  FIELD%PARTITION        =  '0 1 2 3'
  FIELD%SAMEFILE         =  T
  FIELD%TYPE             =  2
  FIELD%TIMEUNIT         = 'S'
  FIELD%TIMEVAR          = 'D'
  FIELD%FCVARS           =  T
  FIELD%NOVAL            =  0.0
/

! -------------------------------------------------------------------- !
! Define the content of the output file via FILE_NML namelist
! -------------------------------------------------------------------- !
&FILE_NML
  FILE%NETCDF        = 4
/

! -------------------------------------------------------------------- !
! Define the content of the output file via SMC_NML namelist
! -------------------------------------------------------------------- !
&SMC_NML
  SMC%TYPE          = 2
  SMC%SXO           = -999.9
  SMC%EXO           = -999.9
  SMC%SYO           = -999.9
  SMC%EYO           = -999.9
  SMC%CELFAC        = 1
/

! -------------------------------------------------------------------- !
! WAVEWATCH III - end of namelist                                      !
! -------------------------------------------------------------------- !
